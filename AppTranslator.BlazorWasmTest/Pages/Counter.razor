@page "/counter"
@using AppTranslator.Interfaces
@inject IAppTranslator Translator
<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<h3>@Translator["hello"]</h3>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;
    protected override async Task OnInitializedAsync()
    {
        await Translator.SetLanguageAsync("pt-BR");
        Translator.LanguageChanged += OnLanguageChanged;
        
    }
    private async Task IncrementCount()
    {
        await Translator.SetLanguageAsync("en-US");
    }
    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }
    public void Dispose()
{
    Translator.LanguageChanged -= OnLanguageChanged;
}
}